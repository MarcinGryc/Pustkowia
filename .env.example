# Skopiuj do .env w katalogu głównym. Sekret wygeneruj np. secrets.token_urlsafe(48).
DATABASE_URL=postgresql+psycopg://pustkowia:pustkowia@localhost:5432/pustkowia
SECRET_KEY=local-development-change-this-secret-key
ENVIRONMENT=development
# Dokładny origin przeglądarki, bez końcowego /. Dla docker compose: http://localhost:8000
APP_ORIGIN=http://localhost:5173
DEMO_ENABLED=false
SESSION_DAYS=14
INTERACTION_RADIUS_M=75
MAX_ACCURACY_M=50
LOCATION_MAX_AGE_S=45
COOLDOWN_SECONDS=900
DEFEAT_COOLDOWN_SECONDS=180
# osm próbuje znaleźć ścieżki Overpass; demonstration od razu używa oznaczonego świata przykładowego.
WORLD_SOURCE=osm
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Opcjonalny pełny URL stylu MapLibre, np. dostawcy z kluczem ograniczonym do domeny.
MAP_STYLE_URL=
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
